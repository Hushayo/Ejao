<resources>
    <style name="Theme.Ejao" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>

        <!-- Brand-colored controls: inputs, checkboxes, focus states -->
        <item name="colorControlNormal">@color/surface_line</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorHint">#A8A29E</item>

        <!-- Outlined text fields get the accent stroke + rounded corners -->
        <item name="textInputStyle">@style/Widget.Ejao.TextInputLayout</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonCornerRadius">12dp</item>

        <!-- Consistent rounded corners for all Material components -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Ejao.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Ejao.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Ejao.LargeComponent</item>

        <!-- Checkbox and Switch styles -->
        <item name="checkboxStyle">@style/Widget.Ejao.CheckBox</item>
        <item name="materialSwitchStyle">@style/Widget.Ejao.Switch</item>
    </style>

    <style name="Widget.Ejao.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="android:textColorHint">#A8A29E</item>
    </style>

    <style name="Widget.Ejao.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox_selector</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">24dp</item>
    </style>

    <style name="Widget.Ejao.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="trackTint">@color/switch_track_selector</item>
    </style>

    <style name="ShapeAppearance.Ejao.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Ejao.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Ejao.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Theme.Ejao.Gate" parent="android:Theme.NoDisplay" />
</resources>